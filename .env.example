# Copy to .env and adjust as needed. All are optional; defaults are sensible.
# (The zero-dependency server reads process.env directly — load this file via your
#  process manager, e.g. systemd EnvironmentFile=, or `set -a; . ./.env; set +a`.)

# HOST=127.0.0.1
# PORT=8787
# OPENMETEO_MODEL=ecmwf_ifs      # long-range model in the blend. 9 km IFS HRES; ecmwf_ifs025 = coarse 0.25°.
# TIMEZONE=Europe/Warsaw
# FORECAST_DAYS=15               # long-range horizon (ECMWF leg of the blend)
# CROSSFADE_H=6                  # width (hours) of the linear blend at each model seam (0 = hard switch)
# The forecast is a seamless blend: ICON-D2 2.2km (today+tomorrow) → ICON-EU 7km
# (days 2–4) → ECMWF (out to FORECAST_DAYS). Each model is fetched on its own
# run-aligned schedule; see src/config.js MODELS to retune the seams/horizons.
# KITE_THRESHOLD_KT=12
# METADATA_POLL_MIN=5            # how often to check the (free) model metadata
# POST_RUN_DELAY_MIN=3          # settle delay after a new run is available before fetching
# SAFETY_REFRESH_MIN=180        # force a refetch if metadata is unreachable this long
# CELL_SELECTION=sea             # sea | land | nearest
